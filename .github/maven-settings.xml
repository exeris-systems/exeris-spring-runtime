<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <!-- Tokens are injected via env vars; never hardcode credentials. -->
    <server>
      <id>github-exeris-runtime-releases</id>
      <username>exeris-systems</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>github-exeris-runtime-snapshots</id>
      <username>exeris-systems</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <!--
      Maven Central (release profile only). Credentials are a USER TOKEN generated at
      central.sonatype.com/usertoken, not the account password, and arrive from the workflow
      environment. The id must match <publishingServerId> in the root POM's release profile.
    -->
    <server>
      <id>central</id>
      <username>${env.CENTRAL_TOKEN_USERNAME}</username>
      <password>${env.CENTRAL_TOKEN_PASSWORD}</password>
    </server>
  </servers>
</settings>
