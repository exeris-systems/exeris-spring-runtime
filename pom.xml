<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Exeris Spring Runtime — Root Reactor POM
        =========================================
        This is the top-level reactor. It orchestrates the build order and
        centralises version management via the BOM submodule.

        This project is NOT a Spring Boot starter.
        It is a host-runtime integration layer in which:
          - Spring provides application model, DI, and configuration ergonomics.
          - Exeris owns transport ingress, request lifecycle, backpressure,
            off-heap memory, provider discovery, and runtime telemetry.

        See docs/architecture/overview.md for the full architectural contract.
    -->

    <groupId>eu.exeris</groupId>
    <artifactId>exeris-spring-runtime-parent</artifactId>
    <version>0.8.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Spring Runtime :: Parent</name>
    <description>Host-runtime integration layer enabling Spring applications to run on top of the Exeris execution model.</description>

    <modules>
        <module>exeris-spring-runtime-bom</module>
        <module>exeris-spring-runtime-build-config</module>
        <module>exeris-spring-boot-autoconfigure</module>
        <module>exeris-spring-runtime-web</module>
        <module>exeris-spring-runtime-tx</module>
        <module>exeris-spring-runtime-data</module>
        <module>exeris-spring-runtime-actuator</module>
        <module>exeris-spring-runtime-events</module>
        <module>exeris-spring-runtime-flow</module>
        <module>exeris-spring-runtime-graph</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java baseline: Java 25 LTS (class-file 69.0). -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Pinned to a published kernel release (clean, not -SNAPSHOT): -SNAPSHOT references
             fail to resolve from GitHub Packages in CI. 0.12.0 is GA (JDK 25 LTS, class-file 69.0).
             See ADR-068 for the artefact model. -->
        <exeris.kernel.version>0.12.0</exeris.kernel.version>

        <!-- Spring Boot dual matrix per ADR-028. Tracking the active 4.x line (4.1.x)
             maintains load-bearing verification against current releases. -->
        <spring.boot.sb3.version>3.5.14</spring.boot.sb3.version>
        <spring.boot.sb4.version>4.1.0</spring.boot.sb4.version>
        <spring.boot.version>${spring.boot.sb3.version}</spring.boot.version>
        <spring.framework.version>6.2.4</spring.framework.version>

        <!-- Build tooling -->
        <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.2.5</maven.failsafe.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>

        <!-- Coverage quality gate (opt-in via -Pcoverage). JaCoCo 0.8.15 supports class-file
             major version 70; kept ahead of baseline so class-file parsing succeeds. -->
        <jacoco.maven.plugin.version>0.8.15</jacoco.maven.plugin.version>
        <jacoco.line.minimum>0.00</jacoco.line.minimum>
        <coverage.argLine/>

        <!-- Test tooling. ArchUnit 1.4.2 bundles ASM reading class files up to major version 70;
             keeping the reader ahead of or level with baseline ensures boundary guards do not quietly skip unparsed classes. -->
        <archunit.version>1.4.2</archunit.version>
        <jackson.annotations.version>2.21</jackson.annotations.version>

        <!-- Test JVM arguments aligned with kernel runtime conventions. -->
        <test.jvm.args>-XX:+UnlockExperimentalVMOptions -XX:+UseZGC</test.jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris Kernel BOM -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-bom</artifactId>
                <version>${exeris.kernel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot BOM — governs all Spring dependency versions.
                 IMPORTANT: spring-boot-starter-web and spring-boot-starter-webflux
                 are NEVER imported in any module. Tomcat, Jetty, Undertow, and Netty
                 are excluded from the runtime classpath.
                 Exeris owns the transport layer. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal module versions -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-tx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-actuator</artifactId>
                <version>${project.version}</version>
            </dependency>

                <!-- Architecture guards -->
                <dependency>
                    <groupId>com.tngtech.archunit</groupId>
                    <artifactId>archunit-junit5</artifactId>
                    <version>${archunit.version}</version>
                    <scope>test</scope>
                </dependency>

            <!-- Jackson annotations version override for Jackson 3.x compatibility in kernel-community. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>github-exeris-kernel</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-exeris-spring-runtime</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-spring-runtime</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>github-exeris-runtime-releases</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-spring-runtime</url>
        </repository>
        <snapshotRepository>
            <id>github-exeris-runtime-snapshots</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-spring-runtime</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <!-- Absence of preview flags enforces preview-clean class files per policy (.agents/policies/jdk-baseline.md). -->
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <argLine>@{coverage.argLine} ${test.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                    <configuration>
                        <argLine>@{coverage.argLine} ${test.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                    <configuration>
                        <!-- Holds upload until all modules pass, preventing partial releases on GitHub Packages. -->
                        <deployAtEnd>true</deployAtEnd>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.plugin.version}</version>
                    <configuration>
                        <tags>
                            <tag>
                                <name>apiNote</name>
                                <placement>a</placement>
                                <head>API Note:</head>
                            </tag>
                            <tag>
                                <name>implSpec</name>
                                <placement>a</placement>
                                <head>Implementation Requirements:</head>
                            </tag>
                            <tag>
                                <name>implNote</name>
                                <placement>a</placement>
                                <head>Implementation Note:</head>
                            </tag>
                        </tags>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Spring Boot dual matrix per ADR-028: matrix-sb3 (default) and matrix-sb4.
             activeByDefault is disabled when any other profile (e.g. -Pcoverage) is activated,
             so CI names matrix profiles explicitly. -->
        <profile>
            <id>matrix-sb3</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.boot.version>${spring.boot.sb3.version}</spring.boot.version>
            </properties>
        </profile>

        <profile>
            <id>matrix-sb4</id>
            <properties>
                <spring.boot.version>${spring.boot.sb4.version}</spring.boot.version>
            </properties>
        </profile>

        <!-- Opt-in code coverage profile. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>coverage.argLine</propertyName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <formats>
                                        <format>XML</format>
                                        <format>HTML</format>
                                    </formats>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <haltOnFailure>true</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
