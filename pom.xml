<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Exeris Spring Runtime — Root Reactor POM
        =========================================
        This is the top-level reactor. It orchestrates the build order and
        centralises version management via the BOM submodule.

        This project is NOT a Spring Boot starter.
        It is a host-runtime integration layer in which:
          - Spring provides application model, DI, and configuration ergonomics.
          - Exeris owns transport ingress, request lifecycle, backpressure,
            off-heap memory, provider discovery, and runtime telemetry.

        See docs/architecture/overview.md for the full architectural contract.
    -->

    <groupId>eu.exeris</groupId>
    <artifactId>exeris-spring-runtime-parent</artifactId>
    <version>0.8.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Exeris Spring Runtime :: Parent</name>
    <description>Host-runtime integration layer enabling Spring applications to run on top of the Exeris execution model.</description>

    <!--
        Maven appends a child's artifactId to an inherited project <url>, which would publish a
        project page that does not exist for every module. Each module therefore declares its own
        <url> verbatim. The scm attributes below stop the same append for the scm coordinates.
    -->
    <url>https://github.com/exeris-systems/exeris-spring-runtime</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Exeris Systems</name>
        <url>https://github.com/exeris-systems</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>
                Distributed under the unmodified Apache License, Version 2.0 — SPDX identifier
                "Apache-2.0". See LICENSE in the repository root for the full text and
                LICENSING.md for the map. Apache-2.0 section 6 grants no trademark rights.
            </comments>
        </license>
    </licenses>

    <!-- Central requires at least one developer entry: the point of contact behind the coordinate. -->
    <developers>
        <developer>
            <id>aprzychocki</id>
            <name>Arkadiusz Przychocki</name>
            <organization>Exeris Systems</organization>
            <organizationUrl>https://github.com/exeris-systems</organizationUrl>
            <roles>
                <role>Founder</role>
                <role>Lead Architect</role>
            </roles>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/exeris-systems/exeris-spring-runtime.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/exeris-systems/exeris-spring-runtime.git</developerConnection>
        <url>https://github.com/exeris-systems/exeris-spring-runtime</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>exeris-spring-runtime-bom</module>
        <module>exeris-spring-runtime-build-config</module>
        <module>exeris-spring-boot-autoconfigure</module>
        <module>exeris-spring-runtime-web</module>
        <module>exeris-spring-runtime-tx</module>
        <module>exeris-spring-runtime-data</module>
        <module>exeris-spring-runtime-actuator</module>
        <module>exeris-spring-runtime-events</module>
        <module>exeris-spring-runtime-flow</module>
        <module>exeris-spring-runtime-graph</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java baseline: Java 25 LTS (class-file 69.0). -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Pinned to a published kernel release (clean, not -SNAPSHOT), resolved from Maven
             Central. The GA line (eu.exeris:*) targets JDK 25 LTS, class-file 69.0; the preview
             line is a separate groupId. See ADR-068 for the artefact model. -->
        <exeris.kernel.version>0.13.1</exeris.kernel.version>

        <!-- Spring Boot dual matrix per ADR-028. Tracking the active 4.x line (4.1.x)
             maintains load-bearing verification against current releases. -->
        <spring.boot.sb3.version>3.5.14</spring.boot.sb3.version>
        <spring.boot.sb4.version>4.1.0</spring.boot.sb4.version>
        <!-- Fallback keeping reactor resolvable if neither matrix profile is active. -->
        <spring.boot.version>${spring.boot.sb3.version}</spring.boot.version>
        <spring.framework.version>6.2.4</spring.framework.version>
        <logback.version>1.6.6</logback.version>

        <!-- Build tooling -->
        <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.2.5</maven.failsafe.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <!-- 0.12.0 or later: earlier versions leave Maven 3.10 resolver bookkeeping in the bundle, which Central refuses. -->
        <central.publishing.plugin.version>0.12.0</central.publishing.plugin.version>

        <!-- Coverage quality gate (opt-in via -Pcoverage). JaCoCo 0.8.15 supports class-file
             major version 70; kept ahead of baseline so class-file parsing succeeds. -->
        <jacoco.maven.plugin.version>0.8.15</jacoco.maven.plugin.version>
        <jacoco.line.minimum>0.00</jacoco.line.minimum>
        <!-- Consumed late-bound (@{coverage.argLine}) by surefire/failsafe so jacoco:prepare-agent attaches. -->
        <coverage.argLine/>

        <!-- Test tooling. ArchUnit 1.4.2 bundles ASM reading class files up to major version 70;
             keeping the reader ahead of or level with baseline ensures boundary guards do not quietly skip unparsed classes. -->
        <archunit.version>1.4.2</archunit.version>
        <jackson.annotations.version>2.21</jackson.annotations.version>

        <!-- Test JVM arguments aligned with kernel runtime conventions. -->
        <test.jvm.args>-XX:+UnlockExperimentalVMOptions -XX:+UseZGC</test.jvm.args>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exeris Kernel BOM -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-kernel-bom</artifactId>
                <version>${exeris.kernel.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Logback is ahead of both Boot BOMs: the versions they manage carry CVE-2026-9828
                 and CVE-2026-19880, fixed in 1.6.3. Declared before the BOM import, which only
                 supplies versions not already managed here. -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Spring Boot BOM — governs all Spring dependency versions.
                 IMPORTANT: spring-boot-starter-web and spring-boot-starter-webflux
                 are NEVER imported in any module. Tomcat, Jetty, Undertow, and Netty
                 are excluded from the runtime classpath.
                 Exeris owns the transport layer. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal module versions -->
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-tx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.exeris</groupId>
                <artifactId>exeris-spring-runtime-actuator</artifactId>
                <version>${project.version}</version>
            </dependency>

                <!-- Architecture guards -->
                <dependency>
                    <groupId>com.tngtech.archunit</groupId>
                    <artifactId>archunit-junit5</artifactId>
                    <version>${archunit.version}</version>
                    <scope>test</scope>
                </dependency>

            <!-- Jackson annotations version override for Jackson 3.x compatibility in kernel-community. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github-exeris-runtime-releases</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-spring-runtime</url>
        </repository>
        <snapshotRepository>
            <id>github-exeris-runtime-snapshots</id>
            <url>https://maven.pkg.github.com/exeris-systems/exeris-spring-runtime</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <!-- Absence of preview flags enforces preview-clean class files per policy (.agents/policies/jdk-baseline.md). -->
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <argLine>@{coverage.argLine} ${test.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                    <configuration>
                        <argLine>@{coverage.argLine} ${test.jvm.args}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                    <configuration>
                        <!-- Holds upload until all modules pass, preventing partial releases on GitHub Packages. -->
                        <deployAtEnd>true</deployAtEnd>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.plugin.version}</version>
                    <configuration>
                        <tags>
                            <tag>
                                <name>apiNote</name>
                                <placement>a</placement>
                                <head>API Note:</head>
                            </tag>
                            <tag>
                                <name>implSpec</name>
                                <placement>a</placement>
                                <head>Implementation Requirements:</head>
                            </tag>
                            <tag>
                                <name>implNote</name>
                                <placement>a</placement>
                                <head>Implementation Note:</head>
                            </tag>
                        </tags>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Spring Boot dual matrix per ADR-028: matrix-sb3 (default) and matrix-sb4.
             activeByDefault is disabled when any other profile (e.g. -Pcoverage) is activated,
             so CI names matrix profiles explicitly. -->
        <profile>
            <id>matrix-sb3</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.boot.version>${spring.boot.sb3.version}</spring.boot.version>
            </properties>
        </profile>

        <profile>
            <id>matrix-sb4</id>
            <properties>
                <spring.boot.version>${spring.boot.sb4.version}</spring.boot.version>
            </properties>
        </profile>

        <!-- Opt-in code coverage profile. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.maven.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <propertyName>coverage.argLine</propertyName>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <formats>
                                        <format>XML</format>
                                        <format>HTML</format>
                                    </formats>
                                </configuration>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <haltOnFailure>true</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Maven Central publication, activated only by `-P release`. It is a profile on purpose:
            central-publishing-maven-plugin is a build extension that takes over the deploy phase,
            and declared outside this profile it would also capture the snapshot publish that every
            push to main sends to GitHub Packages. Without the profile the deploy phase goes to
            GitHub Packages through <distributionManagement>; with it, to Central.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central requires a sources jar for every published jar coordinate. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Central requires a javadoc jar to exist; it does not judge its prose. Javadoc
                        quality is not what decides whether a release can publish, so doclint is off
                        and a javadoc error does not fail this build. The contract tags are inherited
                        from pluginManagement: an unregistered tag is dropped from the page silently.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>

                    <!--
                        Central verifies a detached signature on every file. The passphrase arrives
                        through the environment variable that actions/setup-java's `gpg-passphrase`
                        input names; deploy.yml sets both to MAVEN_GPG_PASSPHRASE.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        autoPublish=false: the upload creates a deployment that a person publishes in
                        the Central Portal after reading its validation result. Until then it can be
                        dropped; once published, a version can never be changed or reused.
                        waitUntil=validated makes the build wait for that result rather than pass on
                        the upload alone. skipUpload builds the bundle and sends nothing, which is
                        what the dry run in deploy.yml uses.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central.publishing.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
