<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris.examples</groupId>
        <artifactId>exeris-spring-runtime-examples</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <artifactId>compat-mvc</artifactId>
    <name>Example :: Compatibility Mode Spring MVC</name>

    <dependencies>
        <!-- tag::dependencies[] -->
        <!-- spring-boot-starter, not spring-boot-starter-web: the web starter brings Tomcat and
             spring-webmvc, and Exeris owns ingress. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Jackson, for JSON request and response bodies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- Bean Validation, for @Valid on a request body. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Brings spring-web, which holds @RestController, @RequestMapping and the message
             converters. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-spring-runtime-web</artifactId>
        </dependency>
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- end::dependencies[] -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
