<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.exeris</groupId>
        <artifactId>exeris-spring-runtime-parent</artifactId>
        <version>0.8.0-SNAPSHOT</version>
    </parent>

    <artifactId>exeris-spring-runtime-flow</artifactId>

    <name>Exeris Spring Runtime :: Flow / Saga Bridge</name>
    <description>
        Compatibility-friendly bridge that exposes the kernel FlowEngine to Spring beans
        as a structured asynchronous / saga programming model — without making
        Spring @Async (or any thread-pool task executor) the canonical execution path
        for compensable, parkable, or event-triggered work.

        Key capabilities (default-off):
          - FlowEngineSupplier: deferred ScopedValue accessor pattern.
          - ExerisFlowProperties: enabled + persistenceEnabled + choreographyEnabled
            + requireEngine configuration flags.
          - ExerisFlowAutoConfiguration: wires template, registrar, and engine supplier
            from ExerisRuntimeLifecycle.getFlowEngine().
          - ExerisFlowDefinition: interface for Spring beans declaring kernel FlowDefinitions
            through FlowDefinitionBuilder + FlowStepAction lambdas.
          - ExerisFlowTemplate: imperative invocation surface for Spring beans — schedule,
            park, wake, lookupParked, stats, and plan registry.
          - ExerisFlowDefinitionRegistrar: lifecycle bean compiling plans and populating
            the template plan registry.
          - ExerisFlowChoreographyBridge: opt-in event-driven flow trigger discovering
            ExerisFlowChoreographyMapper beans and registering them with the kernel.

        Activation:
          exeris.runtime.flow.enabled = true (matchIfMissing = false)
          exeris.runtime.flow.choreography-enabled = true (opt-in)

        Hard rules:
          - @Async is NOT a workaround for missing flow capability.
          - Durable snapshot persistence (FlowSnapshotStore) is not enabled by default;
            persistenceEnabled defaults to false.
          - Step lambdas closing over Spring beans must not invert lifecycle
            ownership — flow lifecycle stays kernel-owned.
          - Choreography mapper beans receive only an EventDescriptor (routing
            metadata) — no payload, no scheduler reference. Implementations stay
            implementation-blind to the broker.
          - No HTTP / web / persistence concerns in this module.
    </description>

    <properties>
        <!-- Coverage ratchet floor (enforced only under -Pcoverage). Measured LINE 98.4% —
             already past the ~0.85 1.0 GA target; floor guards against regression. -->
        <jacoco.line.minimum>0.97</jacoco.line.minimum>
    </properties>

    <dependencies>

        <!-- Kernel SPI — FlowEngine, FlowScheduler, FlowDefinitionBuilder,
             FlowExecutionPlan, FlowState, ChoreographyDecision, KernelProviders. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-spi</artifactId>
        </dependency>

        <!-- autoconfigure — for ExerisRuntimeLifecycle.getFlowEngine() seam. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-spring-boot-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- events — choreography bridge reads the kernel EventBus through
             EventEngineSupplier from the events module, and gates activation on the
             ExerisEventPublisher bean. flow → events is allowed; the reverse (events → flow) is banned. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-spring-runtime-events</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot autoconfigure — @AutoConfiguration, @ConditionalOn*. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Context — ApplicationContext (for bean discovery), bean lifecycle. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Test scope -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Runtime integration test: a real FlowProvider on the test classpath so the
             kernel bootstrap discovers and binds KernelProviders.FLOW_ENGINE. Production
             classpath stays clean — community is test-scope only. -->
        <dependency>
            <groupId>eu.exeris</groupId>
            <artifactId>exeris-kernel-community</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 in-memory keeps the kernel persistence subsystem happy during runtime IT
             bootstrap. The flow bridge does not depend on persistence; we only need the
             kernel boot DAG to complete so FLOW_ENGINE gets bound. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PureModeClasspathGuardTest uses ArchUnit to enforce pure-mode and
             module-boundary invariants. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
